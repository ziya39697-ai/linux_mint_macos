[desktop/background]
picture-options='zoom'
picture-uri='file:///home/jiya21/Downloads/Golden_Dark_6k.png'

[desktop/background/slideshow]
delay=15
image-source='xml:///usr/share/cinnamon-background-properties/linuxmint-wallpapers.xml'

[desktop/input-sources]
sources=[('xkb', 'us')]

[desktop/interface]
clock-use-24h=false
cursor-size=24
cursor-theme='WhiteSur-cursors'
font-name='Inter 10'
gtk-theme='WhiteSur-Dark-solid'
icon-theme='WhiteSur'

[desktop/keybindings]
custom-list=['custom0']

[desktop/keybindings/custom-keybindings/custom0]
binding=['<Super>a']
command='flatpak run io.github.qwersyk.Newelle'
name='Newelle AI assistant'

[desktop/notifications]
display-notifications=true
notification-duration=4

[desktop/peripherals/mouse]
double-click=400
drag-threshold=8
speed=1.0

[desktop/peripherals/touchpad]
send-events='disabled-on-external-mouse'
speed=0.61764705882352944

[desktop/screensaver]
date-format='%a %b %-d'
floating-widgets=false
font-date='Inter Display Medium 17'
font-message='Inter 12'
font-time='Inter Display Bold 100'
layout-group=0
time-format='%-I:%M'
use-custom-format=true

[desktop/sound]
event-sounds=false

[desktop/wm/preferences]
button-layout='close,minimize,maximize:'
min-window-opacity=30
titlebar-font='Inter Medium 10'

[gestures]
enabled=true
pinch-percent-threshold=uint32 40
swipe-down-2='PUSH_TILE_DOWN::end'
swipe-down-3='TOGGLE_OVERVIEW::end'
swipe-down-4='VOLUME_DOWN::end'
swipe-left-2='PUSH_TILE_LEFT::end'
swipe-left-3='WORKSPACE_NEXT::end'
swipe-left-4='WINDOW_WORKSPACE_PREVIOUS::end'
swipe-percent-threshold=uint32 60
swipe-right-2='PUSH_TILE_RIGHT::end'
swipe-right-3='WORKSPACE_PREVIOUS::end'
swipe-right-4='WINDOW_WORKSPACE_NEXT::end'
swipe-up-2='PUSH_TILE_UP::end'
swipe-up-3='TOGGLE_EXPO::end'
swipe-up-4='VOLUME_UP::end'
tap-3='MEDIA_PLAY_PAUSE::end'

[muffin]
draggable-border-width=10
experimental-features=['scale-monitor-framebuffer', 'x11-randr-fractional-scaling']

[recorder]
file-extension='webm'
framerate=60
pipeline='videoconvert ! queue ! vp8enc min_quantizer=8 max_quantizer=26 cpu-used=16 deadline=1 threads=4 token-partitions=2 keyframe-max-dist=120 buffer-size=6000 ! queue ! mux. pulsesrc device=alsa_output.pci-0000_00_1b.0.analog-stereo.monitor ! audioconvert ! audioresample ! audio/x-raw,channels=2,rate=48000 ! opusenc bitrate=128000 ! queue ! mux. webmmux name=mux'

[settings-daemon/plugins/color]
night-light-enabled=true
night-light-last-coordinates=(22.533332999999999, 88.366667000000007)
night-light-temperature=uint32 4000

[settings-daemon/plugins/power]
lid-close-ac-action='suspend'
lid-close-battery-action='suspend'
sleep-display-ac=1800
sleep-display-battery=1800
sleep-inactive-ac-timeout=0
sleep-inactive-battery-timeout=0

[settings-daemon/plugins/xsettings]
buttons-have-icons=false

[theme]
name='WhiteSur-Dark-solid'
