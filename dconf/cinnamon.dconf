panel-edit-mode=false
panel-zone-icon-sizes='[{"panelId":1,"left":0,"center":0,"right":16}]'
panel-zone-symbolic-icon-sizes='[{"panelId": 1, "left": 16, "center": 16, "right": 16}]'
panel-zone-text-sizes='[{"panelId":1,"left":0,"center":0,"right":9}]'
panels-autohide=['1:false', '2:false']
