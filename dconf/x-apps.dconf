[apps/portal]
color-scheme='prefer-dark'

[pix/browser]
browser-sidebar-width=285
fullscreen-sidebar='hidden'
fullscreen-thumbnails-visible=false
maximized=false
properties-visible=false
sidebar-sections=['GthFileProperties:expanded', 'GthFileComment:expanded', 'GthFileDetails:expanded', 'GthImageHistogram:expanded']
sidebar-visible=true
sort-inverse=false
sort-type='file::mtime'
startup-current-file=''
startup-location='file:///home/jiya21/Pictures'
statusbar-visible=true
viewer-sidebar='hidden'
window-height=675
window-width=1195

[pix/data-migration]
catalogs-2-10=true

[pix/general]
active-extensions=['23hq', 'bookmarks', 'burn_disc', 'catalogs', 'change_date', 'comments', 'contact_sheet', 'convert_format', 'desktop_background', 'edit_metadata', 'exiv2_tools', 'file_manager', 'find_duplicates', 'flicker', 'gstreamer_tools', 'gstreamer_utils', 'image_print', 'image_rotation', 'importer', 'jpeg_utils', 'list_tools', 'oauth', 'photo_importer', 'raw_files', 'red_eye_removal', 'rename_series', 'resize_images', 'search', 'selections', 'slideshow', 'terminal', 'webalbums']

[reader/default]
window-ratio=(1.0084033613445378, 0.71258907363420432)

[sticky]
active-group='Focus on these:\n\n✅ Creating and formatting spreadsheets\n✅ Sorting and filtering\n✅ Basic formulas — SUM, AVERAGE, COUNT, COUNTA\n✅ Dropdowns / data validation\n✅ Conditional formatting\n✅ Finding and removing duplicates\n✅ Basic tables for candidate tracking\n⭐ IF formula — useful to learn\n⭐ Basic VLOOKUP/XLOOKUP — learn later'
disable-delete-confirm=true
first-run=false

[warpinator/preferences]
ask-for-send-permission=true
autostart=false
connect-id='JIYA21-MACBOOKAIR-948460EF9908D3C160B2'
group-code='123432123'
no-overwrite=true
receiving-folder='file:///home/jiya21/Downloads/Warpinator'
