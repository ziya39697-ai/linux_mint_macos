#!/usr/bin/env python3
"""Launchpad — the macOS 26/27 "Applications" window, for Linux Mint Cinnamon.

macOS 26 Tahoe retired the paged, foldered Launchpad for Spotlight's
Applications view, and macOS 27 Golden Gate keeps it: a floating glass window
with one big search field (the apps glyph at its left, a ⋯ menu at its right),
a row of category pills under it, and one alphabetical grid of apps.  This is
that window, built to stay cheap:

  * one Gtk.FlowBox, one plain Image+Label tile per app, no custom drawing,
    no per-tile animation, no drag-and-drop, no folders;
  * icons come from GTK's own icon cache;
  * the frosted backdrop is one root grab per open, blurred by downscaling,
    and dropped again when the window hides;
  * category / search changes are FlowBox filter+sort passes, never rebuilds.

Categories come from the .desktop Categories key.  Right-click a tile for
Add to Dock.  The ⋯ menu switches between the grid and a compact list.
"""

import ast
import math
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")

from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango  # noqa: E402

APP_ID = "com.mindcres.launchpad"
SELF_DESKTOP = "launchpad.desktop"
IFACE_SCHEMA = "org.cinnamon.desktop.interface"

WIN_W, WIN_H = 760, 560      # Tahoe's Applications window at 1440x900
RADIUS = 22
ICON_PX = 56
TILE_W = 118
LIST_ICON_PX = 32
OPEN_MS = 140

CONFIG_DIR = os.path.expanduser("~/.config/launchpad")
VIEW_PATH = os.path.join(CONFIG_DIR, "view")

PLANK_DCONF = "/net/launchpad/plank/docks/dock1/dock-items"
PLANK_LAUNCHERS = os.path.expanduser("~/.config/plank/dock1/launchers")

# Category pills, in Apple's order.  Rules match in RULE_ORDER so a real
# application claims its category before the huge Settings bucket does.
CATEGORIES = [
    ("productivity",  "Productivity & Finance"),
    ("utilities",     "Utilities"),
    ("creativity",    "Creativity"),
    ("social",        "Social"),
    ("entertainment", "Entertainment"),
    ("information",   "Information & Reading"),
    ("developer",     "Developer Tools"),
    ("games",         "Games"),
    ("system",        "System"),
    ("other",         "Other"),
]
RULES = {
    "games":         ("Game",),
    "developer":     ("Development", "IDE", "TextEditor", "Debugger"),
    "creativity":    ("Graphics", "Photography", "Scanning", "AudioVideoEditing",
                      "RasterGraphics", "VectorGraphics", "Music", "Recorder"),
    "social":        ("Email", "InstantMessaging", "Chat", "VideoConference",
                      "Telephony", "Contacts"),
    "entertainment": ("AudioVideo", "Audio", "Video", "Player", "TV"),
    "information":   ("WebBrowser", "News", "Feed", "Dictionary", "Documentation",
                      "Viewer", "Maps", "Weather"),
    "productivity":  ("Office", "WordProcessor", "Spreadsheet", "Presentation",
                      "Calendar", "Finance", "ProjectManagement", "Calculator",
                      "TextTools"),
    "utilities":     ("Utility", "Accessories", "Archiving", "X-GNOME-Utilities",
                      "Monitor", "Filesystem", "Clock", "Network", "FileTransfer"),
    "system":        ("Settings", "HardwareSettings", "DesktopSettings",
                      "X-XFCE-SettingsDialog", "X-Cinnamon-Settings-Panel",
                      "X-GNOME-Settings-Panel", "System", "Administration",
                      "PackageManager", "Security"),
}
RULE_ORDER = ["games", "developer", "creativity", "social", "entertainment",
              "information", "productivity", "utilities", "system"]


# --------------------------------------------------------------------------- #
#  Helpers
# --------------------------------------------------------------------------- #

def ease_out(t):
    return 1.0 - pow(1.0 - t, 3)


def rounded_rect(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def capture_backdrop(x, y, width, height):
    """Grab what is under the window and blur it by downscaling: two bilinear
    passes then a stretch back, about the cost of one frame, once per open."""
    try:
        root = Gdk.get_default_root_window()
        shot = Gdk.pixbuf_get_from_window(root, x, y, width, height)
        if shot is None:
            return None
        small = shot.scale_simple(max(1, width // 24), max(1, height // 24),
                                  GdkPixbuf.InterpType.BILINEAR)
        mid = small.scale_simple(max(1, width // 6), max(1, height // 6),
                                 GdkPixbuf.InterpType.BILINEAR)
        return mid.scale_simple(width, height, GdkPixbuf.InterpType.BILINEAR)
    except Exception as exc:
        print("launchpad: backdrop capture failed: %s" % exc, file=sys.stderr)
        return None


def plank_height(default=120):
    try:
        out = subprocess.check_output(["wmctrl", "-lxG"], text=True,
                                      stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        return default
    for line in out.splitlines():
        parts = line.split(None, 7)
        if len(parts) >= 7 and "plank" in parts[6].lower():
            try:
                h = int(parts[5])
                return h if h > 0 else default
            except ValueError:
                pass
    return default


def search_haystack(app):
    bits = [app.get_display_name() or "", app.get_name() or ""]
    for getter in ("get_generic_name", "get_description"):
        try:
            bits.append(getattr(app, getter)() or "")
        except AttributeError:
            pass
    try:
        bits.extend(app.get_keywords() or [])
    except AttributeError:
        pass
    bits.append(app.get_executable() or "")
    return " ".join(b for b in bits if b).lower()


def all_apps():
    apps = [a for a in Gio.AppInfo.get_all()
            if a.should_show() and a.get_id() != SELF_DESKTOP]
    apps.sort(key=lambda a: (a.get_display_name() or "").lower())
    return apps


def categorise(app):
    cats = set((app.get_categories() or "").split(";"))
    for cid in RULE_ORDER:
        if cats.intersection(RULES[cid]):
            return cid
    return "other"


def is_dark_theme():
    try:
        src = Gio.SettingsSchemaSource.get_default()
        if src is None or src.lookup(IFACE_SCHEMA, True) is None:
            return True
        return "-Dark" in Gio.Settings(schema_id=IFACE_SCHEMA).get_string("gtk-theme")
    except Exception:
        return True


def run_bg(argv):
    try:
        subprocess.Popen(argv, start_new_session=True)
        return True
    except Exception as exc:
        print("launchpad: %s failed: %s" % (argv[0], exc), file=sys.stderr)
        return False


def load_view():
    try:
        with open(VIEW_PATH) as fh:
            return "list" if fh.read().strip() == "list" else "grid"
    except OSError:
        return "grid"


def save_view(view):
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(VIEW_PATH, "w") as fh:
            fh.write(view)
    except OSError:
        pass


# --------------------------------------------------------------------------- #
#  Plank
# --------------------------------------------------------------------------- #

def plank_read_items():
    try:
        raw = subprocess.check_output(["dconf", "read", PLANK_DCONF], text=True,
                                      stderr=subprocess.DEVNULL).strip()
        if raw:
            value = ast.literal_eval(raw)
            if isinstance(value, list):
                return [str(v) for v in value]
    except Exception:
        pass
    return []


def plank_pin(desktop_path):
    if not desktop_path or not os.path.exists(desktop_path):
        return False, "This app has no .desktop file to pin."
    stem = os.path.basename(desktop_path)
    if stem.endswith(".desktop"):
        stem = stem[: -len(".desktop")]
    item = stem + ".dockitem"
    uri = Gio.File.new_for_path(desktop_path).get_uri()
    try:
        os.makedirs(PLANK_LAUNCHERS, exist_ok=True)
        with open(os.path.join(PLANK_LAUNCHERS, item), "w") as fh:
            fh.write("[PlankDockItemPreferences]\nLauncher=%s\n" % uri)
    except OSError as exc:
        return False, "Could not write the dock item: %s" % exc
    items = plank_read_items()
    if item not in items:
        items.append(item)
        try:
            subprocess.call(["dconf", "write", PLANK_DCONF, repr(items)],
                            stderr=subprocess.DEVNULL)
        except Exception as exc:
            return False, "Could not update Plank's settings: %s" % exc
    return True, None


# --------------------------------------------------------------------------- #
#  Window
# --------------------------------------------------------------------------- #

class AppsWindow(Gtk.Window):
    def __init__(self, app):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.gtk_app = app
        self.backdrop = None
        self.category = None
        self.query = ""
        self.view = load_view()
        self.apps = []
        self._hidden_at = 0.0
        self._anim_tick = None
        self._menu_open = False
        self._syncing_pills = False

        self.set_app_paintable(True)
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_title("Launchpad")
        self.get_style_context().add_class("lp-window")
        self.stick()

        visual = self.get_screen().get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)

        self.connect("draw", self.on_draw)
        self.connect("key-press-event", self.on_key)
        self.connect("delete-event", self.on_delete)
        self.connect("focus-out-event", self.on_focus_out)

        self.build_ui()
        self.reload_apps()

        self.monitor = Gio.AppInfoMonitor.get()
        self.monitor.connect("changed", lambda *_: self.reload_apps())

    # -- construction -------------------------------------------------------- #

    def build_ui(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(root)

        # Search row: apps glyph, big field, ⋯ ----------------------------------
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        top.get_style_context().add_class("lp-top")
        glyph = Gtk.Image.new_from_icon_name("view-app-grid-symbolic", Gtk.IconSize.LARGE_TOOLBAR)
        glyph.set_pixel_size(22)
        glyph.get_style_context().add_class("lp-glyph")
        top.pack_start(glyph, False, False, 0)

        # GTK hides an entry's placeholder while it has focus; Tahoe keeps
        # "Applications" (or the chosen category) showing beside the caret,
        # so the hint is a label overlaid behind the entry instead.
        self.entry = Gtk.Entry()
        self.entry.set_has_frame(False)
        self.entry.get_style_context().add_class("lp-search")
        self.entry.connect("changed", self.on_search)
        self.entry.connect("activate", self.on_entry_activate)
        self.entry.connect("key-press-event", self.on_entry_key)
        self.hint = Gtk.Label(label="Applications", xalign=0.0)
        self.hint.get_style_context().add_class("lp-hint")
        self.hint.set_halign(Gtk.Align.START)
        self.hint.set_valign(Gtk.Align.CENTER)
        overlay = Gtk.Overlay()
        overlay.add(self.entry)
        overlay.add_overlay(self.hint)
        overlay.set_overlay_pass_through(self.hint, True)
        top.pack_start(overlay, True, True, 0)

        self.more = Gtk.MenuButton()
        self.more.set_relief(Gtk.ReliefStyle.NONE)
        self.more.get_style_context().add_class("lp-more")
        more_img = Gtk.Image.new_from_icon_name("view-more-symbolic", Gtk.IconSize.MENU)
        more_img.set_pixel_size(18)
        self.more.add(more_img)
        self.more.set_popup(self.build_more_menu())
        top.pack_end(self.more, False, False, 0)
        root.pack_start(top, False, False, 0)

        # Category pills ---------------------------------------------------------
        pill_scroller = Gtk.ScrolledWindow()
        pill_scroller.set_policy(Gtk.PolicyType.EXTERNAL, Gtk.PolicyType.NEVER)
        pill_scroller.get_style_context().add_class("lp-pill-scroller")
        self.pill_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.pill_box.get_style_context().add_class("lp-pills")
        self.pills = {}
        for cid, label in CATEGORIES:
            pill = Gtk.ToggleButton(label=label)
            pill.set_relief(Gtk.ReliefStyle.NONE)
            pill.set_can_focus(False)
            pill.get_style_context().add_class("lp-pill")
            pill.cid = cid
            pill.connect("toggled", self.on_pill)
            self.pill_box.pack_start(pill, False, False, 0)
            self.pills[cid] = pill
        pill_scroller.add(self.pill_box)
        # side-scroll the pill row with the wheel
        pill_scroller.add_events(Gdk.EventMask.SCROLL_MASK | Gdk.EventMask.SMOOTH_SCROLL_MASK)
        pill_scroller.connect("scroll-event", self.on_pill_scroll)
        root.pack_start(pill_scroller, False, False, 0)

        # Grid ---------------------------------------------------------------------
        self.scroller = Gtk.ScrolledWindow()
        self.scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scroller.get_style_context().add_class("lp-scroller")
        root.pack_start(self.scroller, True, True, 0)

        self.grid = Gtk.FlowBox()
        self.grid.set_valign(Gtk.Align.START)
        self.grid.set_homogeneous(True)
        self.grid.set_selection_mode(Gtk.SelectionMode.NONE)
        self.grid.set_activate_on_single_click(True)
        self.grid.set_column_spacing(2)
        self.grid.set_row_spacing(2)
        self.grid.get_style_context().add_class("lp-grid")
        self.grid.set_filter_func(self.filter_child)
        self.grid.set_sort_func(self.sort_children)
        self.grid.connect("child-activated", self.on_child_activated)
        self.grid.connect("button-press-event", self.on_grid_press)
        self.scroller.add(self.grid)

        self.empty = Gtk.Label(label="No Results")
        self.empty.get_style_context().add_class("lp-empty")
        self.empty.set_no_show_all(True)
        root.pack_start(self.empty, False, False, 0)

        self.apply_view()

    def build_more_menu(self):
        menu = Gtk.Menu()
        menu.get_style_context().add_class("lp-menu")
        group = None
        self.view_items = {}
        for vid, label in (("grid", "Grid"), ("list", "List")):
            mi = Gtk.RadioMenuItem.new_with_label_from_widget(group, label)
            group = group or mi
            mi.vid = vid
            self.view_items[vid] = mi
            menu.append(mi)
        self.view_items[self.view].set_active(True)
        for mi in self.view_items.values():
            mi.connect("toggled", self.on_view_toggled)
        menu.show_all()
        menu.connect("deactivate", lambda *_: GLib.timeout_add(150, self._clear_menu_flag))
        menu.connect("show", lambda *_: setattr(self, "_menu_open", True))
        return menu

    def tile(self, app):
        gicon = app.get_icon()
        if gicon is not None:
            img = Gtk.Image.new_from_gicon(gicon, Gtk.IconSize.DIALOG)
        else:
            img = Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.DIALOG)
        label = Gtk.Label(label=app.get_display_name() or app.get_name() or "")
        label.set_ellipsize(Pango.EllipsizeMode.END)
        label.get_style_context().add_class("lp-app-label")

        child = Gtk.FlowBoxChild()
        child.set_can_focus(True)
        child.img = img
        child.label = label
        child.app = app
        child.app_id = app.get_id()
        child.category = categorise(app)
        child.haystack = search_haystack(app)
        child.sort_key = (app.get_display_name() or "").lower()
        child.box = None
        self.layout_tile(child)
        return child

    def layout_tile(self, child):
        """(Re)pack a tile's image+label for the current view."""
        if child.box is not None:
            child.box.remove(child.img)
            child.box.remove(child.label)
            child.remove(child.box)
        if self.view == "list":
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            box.get_style_context().add_class("lp-row")
            child.img.set_pixel_size(LIST_ICON_PX)
            child.label.set_xalign(0.0)
            child.label.set_justify(Gtk.Justification.LEFT)
            child.label.set_line_wrap(False)
            child.label.set_max_width_chars(-1)
            box.pack_start(child.img, False, False, 0)
            box.pack_start(child.label, True, True, 0)
            child.set_size_request(-1, -1)
        else:
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.get_style_context().add_class("lp-tile")
            child.img.set_pixel_size(ICON_PX)
            child.label.set_xalign(0.5)
            child.label.set_justify(Gtk.Justification.CENTER)
            child.label.set_line_wrap(True)
            child.label.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            child.label.set_lines(2)
            child.label.set_max_width_chars(13)
            box.pack_start(child.img, False, False, 0)
            box.pack_start(child.label, False, False, 0)
            child.set_size_request(TILE_W, -1)
        child.box = box
        child.add(box)
        box.show_all()

    def apply_view(self):
        ctx = self.grid.get_style_context()
        if self.view == "list":
            self.grid.set_min_children_per_line(1)
            self.grid.set_max_children_per_line(1)
            ctx.add_class("lp-list")
        else:
            self.grid.set_min_children_per_line(3)
            self.grid.set_max_children_per_line(12)
            ctx.remove_class("lp-list")
        for child in self.grid.get_children():
            self.layout_tile(child)

    # -- data ---------------------------------------------------------------- #

    def reload_apps(self):
        for child in self.grid.get_children():
            self.grid.remove(child)
        self.apps = all_apps()
        present = set()
        for app in self.apps:
            self.grid.add(self.tile(app))
            present.add(categorise(app))
        for cid, pill in self.pills.items():
            pill.set_visible(cid in present)
        self.grid.show_all()
        self.refilter()

    # -- filtering / sorting -------------------------------------------------- #

    def filter_child(self, child):
        if self.category and child.category != self.category:
            return False
        if self.query:
            return self.query in child.haystack
        return True

    def sort_children(self, a, b):
        return (a.sort_key > b.sort_key) - (a.sort_key < b.sort_key)

    def refilter(self):
        self.grid.invalidate_filter()
        self.grid.invalidate_sort()
        shown = self.visible_children()
        self.empty.set_visible(not shown)
        self.scroller.set_visible(bool(shown))
        adj = self.scroller.get_vadjustment()
        if adj is not None:
            adj.set_value(0)

    def visible_children(self):
        return [c for c in self.grid.get_children() if self.filter_child(c)]

    # -- callbacks ------------------------------------------------------------- #

    def on_pill(self, pill):
        if self._syncing_pills:
            return
        self._syncing_pills = True
        if pill.get_active():
            for other in self.pills.values():
                if other is not pill and other.get_active():
                    other.set_active(False)
            self.category = pill.cid
            self.hint.set_text(dict(CATEGORIES)[pill.cid])
        else:
            self.category = None
            self.hint.set_text("Applications")
        self._syncing_pills = False
        self.entry.grab_focus()
        self.refilter()

    def clear_category(self):
        for pill in self.pills.values():
            if pill.get_active():
                pill.set_active(False)   # on_pill resets category + placeholder

    def on_pill_scroll(self, widget, event):
        adj = widget.get_hadjustment()
        delta = 0.0
        if event.direction == Gdk.ScrollDirection.SMOOTH:
            ok, dx, dy = event.get_scroll_deltas()
            delta = (dx or dy) * 40
        elif event.direction in (Gdk.ScrollDirection.UP, Gdk.ScrollDirection.LEFT):
            delta = -40
        else:
            delta = 40
        adj.set_value(adj.get_value() + delta)
        return True

    def on_search(self, entry):
        self.query = entry.get_text().strip().lower()
        self.hint.set_visible(not entry.get_text())
        self.refilter()

    def on_entry_activate(self, *_):
        shown = self.visible_children()
        if shown:
            self.launch(shown[0].app)

    def on_entry_key(self, entry, event):
        if event.keyval == Gdk.KEY_Down:
            shown = self.visible_children()
            if shown:
                shown[0].grab_focus()
            return True
        if event.keyval == Gdk.KEY_BackSpace and not entry.get_text() and self.category:
            self.clear_category()
            return True
        return False

    def on_view_toggled(self, item):
        if not item.get_active() or item.vid == self.view:
            return
        self.view = item.vid
        save_view(self.view)
        self.apply_view()
        self.refilter()

    def on_child_activated(self, flowbox, child):
        if self._menu_open:
            return
        self.launch(child.app)

    def on_grid_press(self, widget, event):
        if event.button != 3:
            return False
        child = self.grid.get_child_at_pos(int(event.x), int(event.y))
        if child is None:
            return False
        self.popup_menu(child, event)
        return True

    def on_key(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            if self.entry.get_text():
                self.entry.set_text("")
            elif self.category:
                self.clear_category()
            else:
                self.hide_launcher()
            return True
        if self.entry.has_focus():
            return False
        ch = Gdk.keyval_to_unicode(event.keyval)
        if ch and chr(ch).isprintable() and not (event.state & Gdk.ModifierType.CONTROL_MASK):
            self.entry.grab_focus()
            self.entry.set_text(self.entry.get_text() + chr(ch))
            self.entry.set_position(-1)
            return True
        return False

    def on_focus_out(self, *_):
        GLib.timeout_add(120, self._maybe_hide_on_focus)
        return False

    def _maybe_hide_on_focus(self):
        if self.get_visible() and not self.is_active() and not self._menu_open:
            self.hide_launcher()
        return GLib.SOURCE_REMOVE

    def on_delete(self, *_):
        self.hide_launcher()
        return True

    # -- context menu ---------------------------------------------------------- #

    def popup_menu(self, child, event):
        app = child.app
        menu = Gtk.Menu()
        menu.get_style_context().add_class("lp-menu")

        def item(text, cb):
            mi = Gtk.MenuItem(label=text)
            mi.connect("activate", lambda *_: cb())
            menu.append(mi)
            return mi

        item("Open", lambda: self.launch(app))
        menu.append(Gtk.SeparatorMenuItem())
        item("Add to Dock", lambda: self.pin(app))
        path = app.get_filename() if hasattr(app, "get_filename") else None
        if path:
            item("Show in Files", lambda: run_bg(["xdg-open", os.path.dirname(path)]))
        menu.show_all()
        self._menu_open = True
        menu.connect("deactivate", lambda *_: GLib.timeout_add(150, self._clear_menu_flag))
        menu.popup_at_pointer(event)

    def _clear_menu_flag(self):
        self._menu_open = False
        if self.get_visible() and not self.is_active():
            self.hide_launcher()
        return GLib.SOURCE_REMOVE

    def pin(self, app):
        path = app.get_filename() if hasattr(app, "get_filename") else None
        ok, err = plank_pin(path)
        if not ok:
            print("launchpad: %s" % err, file=sys.stderr)

    # -- launching --------------------------------------------------------------- #

    def launch(self, app):
        ctx = self.get_display().get_app_launch_context()
        ctx.set_timestamp(Gtk.get_current_event_time())
        try:
            app.launch(None, ctx)
        except GLib.Error as exc:
            print("launchpad: could not launch %s: %s" % (app.get_id(), exc.message),
                  file=sys.stderr)
            return
        self.hide_launcher()

    # -- show / hide -------------------------------------------------------------- #

    def work_area(self):
        display = Gdk.Display.get_default()
        monitor = None
        try:
            pointer = display.get_default_seat().get_pointer()
            _, x, y = pointer.get_position()[:3]
            monitor = display.get_monitor_at_point(x, y)
        except Exception:
            monitor = None
        if monitor is None:
            monitor = display.get_primary_monitor() or display.get_monitor(0)
        return monitor.get_workarea()

    def show_launcher(self):
        if self.get_visible():
            self.hide_launcher()
            return
        if GLib.get_monotonic_time() / 1e6 - self._hidden_at < 0.35:
            return

        wa = self.work_area()
        dock = plank_height()
        width = min(WIN_W, wa.width - 60)
        height = min(WIN_H, wa.height - dock - 40)
        x = wa.x + (wa.width - width) // 2
        # Tahoe floats it a little above centre of the free area.
        y = wa.y + max(16, (wa.height - dock - height) * 2 // 5)

        self.set_theme_class()
        self.backdrop = capture_backdrop(x, y, width, height)
        self.set_size_request(width, height)
        self.resize(width, height)
        self.move(x, y)

        self.entry.set_text("")
        self.clear_category()
        self.refilter()

        Gtk.Widget.set_opacity(self, 0.0)
        self.show_all()
        self.move(x, y)
        self.present_with_time(Gtk.get_current_event_time())
        self.entry.grab_focus()
        self.start_open_anim()

    def hide_launcher(self):
        self._hidden_at = GLib.get_monotonic_time() / 1e6
        self._menu_open = False
        self.hide()
        self.backdrop = None      # ~1.7 MB, not worth keeping between opens

    def set_theme_class(self):
        ctx = self.get_style_context()
        if is_dark_theme():
            ctx.remove_class("lp-light")
        else:
            ctx.add_class("lp-light")

    def on_draw(self, widget, cr):
        width = self.get_allocated_width()
        height = self.get_allocated_height()
        light = self.get_style_context().has_class("lp-light")
        cr.set_operator(0)                      # CLEAR: transparent corners
        cr.paint()
        cr.set_operator(2)                      # OVER
        rounded_rect(cr, 0.5, 0.5, width - 1, height - 1, RADIUS)
        cr.clip_preserve()
        if self.backdrop is not None:
            Gdk.cairo_set_source_pixbuf(cr, self.backdrop, 0, 0)
            cr.paint()
        if light:
            cr.set_source_rgba(0.95, 0.95, 0.97, 0.80 if self.backdrop else 0.97)
        else:
            cr.set_source_rgba(0.10, 0.10, 0.12, 0.76 if self.backdrop else 0.96)
        cr.paint()
        cr.reset_clip()
        rounded_rect(cr, 0.5, 0.5, width - 1, height - 1, RADIUS)
        cr.set_line_width(1.0)
        if light:
            cr.set_source_rgba(0, 0, 0, 0.18)
        else:
            cr.set_source_rgba(1, 1, 1, 0.22)
        cr.stroke()
        return False

    def start_open_anim(self):
        start = GLib.get_monotonic_time()

        def tick(widget, clock):
            t = min(1.0, (GLib.get_monotonic_time() - start) / 1000.0 / OPEN_MS)
            Gtk.Widget.set_opacity(self, ease_out(t))
            if t >= 1.0:
                self._anim_tick = None
                return GLib.SOURCE_REMOVE
            return GLib.SOURCE_CONTINUE

        if self._anim_tick is not None:
            self.remove_tick_callback(self._anim_tick)
        self._anim_tick = self.add_tick_callback(tick)


