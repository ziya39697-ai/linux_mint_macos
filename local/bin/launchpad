#!/usr/bin/env python3
"""macOS-style Launchpad for Linux Mint Cinnamon + Plank.

A full-screen, paged, frosted-glass application launcher driven by Gio.AppInfo,
with macOS-style folders (auto-organised on first run, and creatable by
dragging one app onto another).
"""

import ast
import json
import math
import os
import shlex
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")

from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango  # noqa: E402

APP_ID = "com.mindcres.launchpad"
SELF_DESKTOP = "launchpad.desktop"

ICON_PX = 96
MINI_PX = 32          # icons inside a folder preview
TILE_W = 152
# icon area (ICON_PX + 20) + 6px spacing + a two-line label. This is the real
# rendered height; setting it lower just makes row arithmetic wrong, because
# the size request is only a minimum.
TILE_H = 156
COL_SPACING = 26
ROW_SPACING = 18
SIDE_MARGIN = 90
TOP_AREA = 74
DOTS_AREA = 40
FOLDER_COLS = 5
FOLDER_CHROME = 150  # panel padding + name field + screen margin

OPEN_MS = 190
HOVER_MS = 140
HOVER_SCALE = 1.12
PRESS_SCALE = 0.94
DRAG_THRESHOLD = 10
SWIPE_MIN = 55
PAGE_COOLDOWN_US = 260000   # debounce for smooth-scroll page flips
JIGGLE_DEG = 1.6

CONFIG_DIR = os.path.expanduser("~/.config/launchpad")
LAYOUT_PATH = os.path.join(CONFIG_DIR, "layout.json")

PLANK_DCONF = "/net/launchpad/plank/docks/dock1/dock-items"
PLANK_LAUNCHERS = os.path.expanduser("~/.config/plank/dock1/launchers")

RESERVE_DOCK = os.environ.get("LAUNCHPAD_RESERVE_DOCK", "0") == "1"

DND_ITEM = "application/x-launchpad-item"

# First-match wins. Ordered so real applications claim their category before
# the huge Settings bucket sweeps up every control panel.
# Only these groups collapse into a folder. Everything else - Development,
# Graphics, Office, Media, Internet, System, Games - stays a loose icon on the
# grid, the way macOS ships with only Utilities and Other as folders.
# Add a name here to fold that group too.
FOLDER_CATEGORIES = {"Accessories", "Preferences", "Administration", "Other"}
FOLDER_MIN = 3        # smaller groups are not worth a folder

FOLDER_RULES = [
    ("Games",        ("Game",)),
    ("Development",  ("Development", "IDE", "TextEditor")),
    ("Graphics",     ("Graphics", "Photography", "Scanning")),
    ("Office",       ("Office", "WordProcessor", "Spreadsheet", "Presentation")),
    ("Media",        ("AudioVideo", "Audio", "Video", "Player")),
    ("Internet",     ("Network", "WebBrowser", "Email", "InstantMessaging")),
    ("Accessories",  ("Utility", "Accessories", "Archiving", "Calculator")),
    ("Administration", ("Administration", "PackageManager", "Security")),
    ("Preferences",  ("Settings", "HardwareSettings", "DesktopSettings",
                      "X-XFCE-SettingsDialog", "X-Cinnamon-Settings-Panel")),
    ("System",       ("System", "Monitor", "Filesystem")),
]


# --------------------------------------------------------------------------- #
#  Helpers
# --------------------------------------------------------------------------- #

def ease_out(t):
    return 1.0 - pow(1.0 - t, 3)


def run_bg(argv):
    try:
        subprocess.Popen(argv, start_new_session=True)
        return True
    except Exception as exc:
        print("launchpad: %s failed: %s" % (argv[0], exc), file=sys.stderr)
        return False


class Canvas(Gtk.DrawingArea):
    """A DrawingArea that owns no GdkWindow.

    GtkDrawingArea normally creates its own window, and a child's window is
    created after its parent's - so it lands *above* the EventBox's input
    window no matter what set_above_child() says, and swallows every crossing
    and motion event over the icon. That is why hover only worked on the label.
    With no window of its own the events reach the EventBox instead, which is
    what makes hover, dragging and clicking work anywhere on a tile. It also
    saves one X window per tile.
    """

    def __init__(self):
        super().__init__()
        self.set_has_window(False)


def rounded_rect(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def capture_backdrop(width, height):
    try:
        root = Gdk.get_default_root_window()
        shot = Gdk.pixbuf_get_from_window(root, 0, 0, root.get_width(),
                                          root.get_height())
        if shot is None:
            return None
        small = shot.scale_simple(max(1, shot.get_width() // 28),
                                  max(1, shot.get_height() // 28),
                                  GdkPixbuf.InterpType.BILINEAR)
        mid = small.scale_simple(max(1, shot.get_width() // 4),
                                 max(1, shot.get_height() // 4),
                                 GdkPixbuf.InterpType.BILINEAR)
        return mid.scale_simple(width, height, GdkPixbuf.InterpType.BILINEAR)
    except Exception as exc:
        print("launchpad: backdrop capture failed: %s" % exc, file=sys.stderr)
        return None


def plank_window():
    try:
        out = subprocess.check_output(["wmctrl", "-lxG"], text=True,
                                      stderr=subprocess.DEVNULL)
    except Exception:
        return None
    for line in out.splitlines():
        parts = line.split(None, 7)
        if len(parts) < 7 or "plank" not in parts[6].lower():
            continue
        try:
            return (parts[0], int(parts[2]), int(parts[3]),
                    int(parts[4]), int(parts[5]))
        except ValueError:
            return None
    return None


def plank_height(default=140):
    info = plank_window()
    return info[4] if info and info[4] > 0 else default


_icon_cache = {}


def load_icon(app, size):
    key = (app.get_id(), size)
    if key in _icon_cache:
        return _icon_cache[key]
    theme = Gtk.IconTheme.get_default()
    pixbuf = None
    gicon = app.get_icon()
    if gicon is not None:
        try:
            info = theme.lookup_by_gicon(gicon, size,
                                         Gtk.IconLookupFlags.FORCE_SIZE)
            if info is not None:
                pixbuf = info.load_icon()
        except GLib.Error:
            pixbuf = None
        if pixbuf is None and isinstance(gicon, Gio.FileIcon):
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_size(
                    gicon.get_file().get_path(), size, size)
            except GLib.Error:
                pixbuf = None
    if pixbuf is None:
        try:
            pixbuf = theme.load_icon("application-x-executable", size,
                                     Gtk.IconLookupFlags.FORCE_SIZE)
        except GLib.Error:
            pixbuf = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, True, 8,
                                          size, size)
            pixbuf.fill(0x00000000)
    _icon_cache[key] = pixbuf
    return pixbuf


def search_haystack(app):
    bits = [app.get_display_name() or "", app.get_name() or ""]
    for getter in ("get_generic_name", "get_description"):
        try:
            bits.append(getattr(app, getter)() or "")
        except AttributeError:
            pass
    try:
        bits.extend(app.get_keywords() or [])
    except AttributeError:
        pass
    bits.append(app.get_executable() or "")
    return " ".join(b for b in bits if b).lower()


def all_apps():
    apps = [a for a in Gio.AppInfo.get_all()
            if a.should_show() and a.get_id() != SELF_DESKTOP]
    apps.sort(key=lambda a: (a.get_display_name() or "").lower())
    return apps


def categorise(app):
    """Return the folder name this app belongs in, or None to leave it loose."""
    cats = set((app.get_categories() or "").split(";"))
    for name, keys in FOLDER_RULES:
        if cats.intersection(keys):
            return name
    return "Other"


# --------------------------------------------------------------------------- #
#  Layout persistence
# --------------------------------------------------------------------------- #

class Layout:
    """Top-level ordering of folders and loose apps, persisted as JSON."""

    def __init__(self):
        self.items = []          # {"type":"folder","id","name","apps":[ids]} | {"type":"app","id"}
        self._next_folder = 1

    # -- construction ---------------------------------------------------- #

    def new_folder_id(self):
        while True:
            fid = "f%d" % self._next_folder
            self._next_folder += 1
            if not any(i["type"] == "folder" and i["id"] == fid
                       for i in self.items):
                return fid

    @classmethod
    def auto(cls, apps):
        """Loose icons for real applications, folders for the utility buckets."""
        layout = cls()
        buckets = {}
        for app in apps:
            buckets.setdefault(categorise(app), []).append(app.get_id())

        folders, loose = [], []
        for name in [n for n, _ in FOLDER_RULES] + ["Other"]:
            ids = buckets.get(name)
            if not ids:
                continue
            if name in FOLDER_CATEGORIES and len(ids) >= FOLDER_MIN:
                folders.append({"type": "folder", "id": layout.new_folder_id(),
                                "name": name, "apps": ids})
            else:
                loose.extend(ids)

        # `apps` arrives alphabetical, so reuse its order for the loose icons
        rank = {a.get_id(): i for i, a in enumerate(apps)}
        loose.sort(key=lambda i: rank.get(i, 0))
        # folders last, like the Utilities folder at the end of Launchpad
        layout.items = [{"type": "app", "id": i} for i in loose] + folders
        return layout

    # -- persistence ------------------------------------------------------ #

    def save(self):
        try:
            os.makedirs(CONFIG_DIR, exist_ok=True)
            tmp = LAYOUT_PATH + ".tmp"
            with open(tmp, "w") as fh:
                json.dump({"version": 1, "items": self.items}, fh, indent=1)
            os.replace(tmp, LAYOUT_PATH)
        except OSError as exc:
            print("launchpad: could not save layout: %s" % exc, file=sys.stderr)

    @classmethod
    def load(cls, apps):
        known = {a.get_id(): a for a in apps}
        layout = cls()
        raw = None
        if os.path.exists(LAYOUT_PATH):
            try:
                with open(LAYOUT_PATH) as fh:
                    raw = json.load(fh)
            except (OSError, ValueError) as exc:
                print("launchpad: layout unreadable (%s), regenerating" % exc,
                      file=sys.stderr)
        if not raw or not isinstance(raw.get("items"), list):
            layout = cls.auto(apps)
            layout.save()
            return layout

        seen = set()
        for entry in raw["items"]:
            if not isinstance(entry, dict):
                continue
            if entry.get("type") == "folder":
                ids = [i for i in entry.get("apps", [])
                       if i in known and i not in seen]
                seen.update(ids)
                if not ids:
                    continue
                layout.items.append({"type": "folder",
                                     "id": entry.get("id") or layout.new_folder_id(),
                                     "name": entry.get("name") or "Folder",
                                     "apps": ids})
            elif entry.get("type") == "app":
                aid = entry.get("id")
                if aid in known and aid not in seen:
                    seen.add(aid)
                    layout.items.append({"type": "app", "id": aid})

        # newly installed apps join their category folder, or sit loose
        for app in apps:
            if app.get_id() in seen:
                continue
            name = categorise(app)
            folder = next((i for i in layout.items
                           if i["type"] == "folder" and i["name"] == name), None)
            if folder:
                folder["apps"].append(app.get_id())
            else:
                layout.items.append({"type": "app", "id": app.get_id()})
        return layout

    # -- mutation --------------------------------------------------------- #

    def find_folder(self, fid):
        return next((i for i in self.items
                     if i["type"] == "folder" and i["id"] == fid), None)

    def remove_app(self, app_id):
        for entry in list(self.items):
            if entry["type"] == "app" and entry["id"] == app_id:
                self.items.remove(entry)
            elif entry["type"] == "folder" and app_id in entry["apps"]:
                entry["apps"].remove(app_id)
                if len(entry["apps"]) == 1:
                    # a folder down to one app collapses back to a loose icon
                    idx = self.items.index(entry)
                    self.items[idx] = {"type": "app", "id": entry["apps"][0]}
                elif not entry["apps"]:
                    self.items.remove(entry)

    def make_folder(self, app_a, app_b, name):
        """Drop app_a onto app_b: build a folder where app_b sat."""
        target = next((i for i in self.items
                       if i["type"] == "app" and i["id"] == app_b), None)
        if target is None:
            return None
        index = self.items.index(target)
        self.remove_app(app_a)
        target = next((i for i in self.items
                       if i["type"] == "app" and i["id"] == app_b), None)
        if target is None:
            return None
        index = self.items.index(target)
        folder = {"type": "folder", "id": self.new_folder_id(),
                  "name": name, "apps": [app_b, app_a]}
        self.items[index] = folder
        return folder

    def add_to_folder(self, app_id, fid):
        folder = self.find_folder(fid)
        if folder is None or app_id in folder["apps"]:
            return None
        self.remove_app(app_id)
        folder = self.find_folder(fid)
        if folder is None:
            return None
        folder["apps"].append(app_id)
        return folder


# --------------------------------------------------------------------------- #
#  Plank integration
# --------------------------------------------------------------------------- #

def plank_read_items():
    try:
        raw = subprocess.check_output(["dconf", "read", PLANK_DCONF], text=True,
                                      stderr=subprocess.DEVNULL).strip()
        if raw:
            value = ast.literal_eval(raw)
            if isinstance(value, list):
                return [str(v) for v in value]
    except Exception:
        pass
    return []


def plank_pin(desktop_path):
    if not desktop_path or not os.path.exists(desktop_path):
        return False, "This app has no .desktop file to pin."
    stem = os.path.basename(desktop_path)
    if stem.endswith(".desktop"):
        stem = stem[: -len(".desktop")]
    item = stem + ".dockitem"
    uri = Gio.File.new_for_path(desktop_path).get_uri()
    try:
        os.makedirs(PLANK_LAUNCHERS, exist_ok=True)
        with open(os.path.join(PLANK_LAUNCHERS, item), "w") as fh:
            fh.write("[PlankDockItemPreferences]\nLauncher=%s\n" % uri)
    except OSError as exc:
        return False, "Could not write the dock item: %s" % exc
    items = plank_read_items()
    if item not in items:
        items.append(item)
        try:
            subprocess.call(["dconf", "write", PLANK_DCONF, repr(items)],
                            stderr=subprocess.DEVNULL)
        except Exception as exc:
            return False, "Could not update Plank's settings: %s" % exc
    return True, None


# --------------------------------------------------------------------------- #
#  Tile (an app, or a folder)
# --------------------------------------------------------------------------- #

class Tile(Gtk.EventBox):
    """One grid cell. Holds either an app or a folder."""

    def __init__(self, window, app=None, folder=None):
        super().__init__()
        self.win = window
        self.app = app
        self.folder = folder
        self.path = app.get_filename() if app else None
        self.haystack = search_haystack(app) if app else ""
        self._pixbuf = None

        self.scale = 1.0
        self.target_scale = 1.0
        self.anim_from = 1.0
        self.anim_start = 0
        self.angle = 0.0
        self.drop_hint = False
        self._press_timer = None
        self._press_xy = None
        self._gesture = None

        self.set_visible_window(False)
        # The icon is a DrawingArea, which owns its own GdkWindow. With the
        # event window below it, every crossing and motion event over the icon
        # went to the DrawingArea and never reached this EventBox - hover only
        # worked over the label, which has no window. Putting the event window
        # above the children makes the whole tile responsive.
        self.set_above_child(True)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                        | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.POINTER_MOTION_MASK
                        | Gdk.EventMask.ENTER_NOTIFY_MASK
                        | Gdk.EventMask.LEAVE_NOTIFY_MASK)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_size_request(TILE_W, TILE_H)

        self.icon_area = Canvas()
        self.icon_area.set_size_request(TILE_W, ICON_PX + 20)
        self.icon_area.connect("draw", self.on_icon_draw)
        box.pack_start(self.icon_area, False, False, 0)

        self.label = Gtk.Label(label=self.display_name())
        self.label.set_line_wrap(True)
        self.label.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        self.label.set_lines(2)
        self.label.set_ellipsize(Pango.EllipsizeMode.END)
        self.label.set_justify(Gtk.Justification.CENTER)
        self.label.set_max_width_chars(16)
        self.label.get_style_context().add_class("app-label")
        box.pack_start(self.label, False, False, 0)
        self.add(box)

        self.connect("enter-notify-event", self.on_enter)
        self.connect("leave-notify-event", self.on_leave)
        self.connect("button-press-event", self.on_press)
        self.connect("button-release-event", self.on_release)
        self.connect("motion-notify-event", self.on_motion)

        # Drag source is started by hand in on_motion (see there).
        self.targets = Gtk.TargetList.new([])
        self.targets.add(Gdk.Atom.intern(DND_ITEM, False), Gtk.TargetFlags.SAME_APP, 0)
        if app is not None:
            self.targets.add(Gdk.Atom.intern("text/uri-list", False), 0, 1)
            self.targets.add(Gdk.Atom.intern("application/x-desktop", False), 0, 2)
            self.targets.add_text_targets(3)
        self.connect("drag-begin", self.on_drag_begin)
        self.connect("drag-data-get", self.on_drag_data_get)
        self.connect("drag-end", self.on_drag_end)

        # ...and a drop target, so dropping one app on another makes a folder.
        self.drag_dest_set(Gtk.DestDefaults.DROP, [],
                           Gdk.DragAction.COPY | Gdk.DragAction.MOVE)
        dest = Gtk.TargetList.new([])
        dest.add(Gdk.Atom.intern(DND_ITEM, False), Gtk.TargetFlags.SAME_APP, 0)
        self.drag_dest_set_target_list(dest)
        self.connect("drag-motion", self.on_drag_motion)
        self.connect("drag-leave", self.on_drag_leave)
        self.connect("drag-data-received", self.on_drag_data_received)

    # -- identity ---------------------------------------------------------- #

    def key(self):
        return self.app.get_id() if self.app else "folder:" + self.folder["id"]

    def is_folder(self):
        return self.folder is not None

    def display_name(self):
        if self.folder:
            return self.folder["name"]
        return self.app.get_display_name() or ""

    def refresh_label(self):
        self.label.set_text(self.display_name())

    # -- drawing ------------------------------------------------------------ #

    def pixbuf(self):
        if self._pixbuf is None and self.app is not None:
            self._pixbuf = load_icon(self.app, ICON_PX)
        return self._pixbuf

    def folder_previews(self):
        infos = self.win.apps_by_id
        out = []
        for aid in self.folder["apps"][:9]:
            app = infos.get(aid)
            if app is not None:
                out.append(load_icon(app, MINI_PX))
        return out

    def on_icon_draw(self, area, cr):
        w = area.get_allocated_width()
        h = area.get_allocated_height()
        scale = self.scale * self.win.anim_scale

        if self.drop_hint:
            cr.save()
            rounded_rect(cr, w / 2 - ICON_PX / 2 - 8, h / 2 - ICON_PX / 2 - 8,
                         ICON_PX + 16, ICON_PX + 16, 22)
            cr.set_source_rgba(1, 1, 1, 0.22)
            cr.fill()
            cr.restore()

        cr.save()
        cr.translate(w / 2.0, h / 2.0)
        if self.angle:
            cr.rotate(self.angle)
        cr.scale(scale, scale)
        if self.is_folder():
            self.draw_folder(cr)
        else:
            pb = self.pixbuf()
            cr.translate(-pb.get_width() / 2.0, -pb.get_height() / 2.0)
            Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
            cr.paint()
        cr.restore()

        if self.win.jiggling and not self.is_folder():
            self.draw_badge(cr, w, h)
        return False

    def draw_folder(self, cr):
        size = ICON_PX
        cr.translate(-size / 2.0, -size / 2.0)
        rounded_rect(cr, 0, 0, size, size, 21)
        cr.set_source_rgba(1, 1, 1, 0.17)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, 0.13)
        cr.set_line_width(1)
        cr.stroke()

        pad, gap = 10, 5
        cell = (size - 2 * pad - 2 * gap) / 3.0
        for i, pb in enumerate(self.folder_previews()):
            row, col = divmod(i, 3)
            x = pad + col * (cell + gap)
            y = pad + row * (cell + gap)
            factor = cell / pb.get_width()
            cr.save()
            cr.translate(x, y)
            cr.scale(factor, factor)
            Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
            cr.paint()
            cr.restore()

    def draw_badge(self, cr, w, h):
        r = 11.0
        cx = w / 2.0 - ICON_PX / 2.0 + 2
        cy = h / 2.0 - ICON_PX / 2.0 + 2
        cr.save()
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.set_source_rgba(0.16, 0.16, 0.18, 0.97)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, 0.85)
        cr.set_line_width(1.4)
        cr.stroke()
        cr.set_source_rgba(1, 1, 1, 0.95)
        cr.set_line_width(2.0)
        cr.set_line_cap(1)
        d = 4.0
        cr.move_to(cx - d, cy - d); cr.line_to(cx + d, cy + d)
        cr.move_to(cx + d, cy - d); cr.line_to(cx - d, cy + d)
        cr.stroke()
        cr.restore()

    def badge_hit(self, x, y):
        alloc = self.icon_area.get_allocation()
        own = self.get_allocation()
        cx = (alloc.x - own.x) + alloc.width / 2.0 - ICON_PX / 2.0 + 2
        cy = (alloc.y - own.y) + alloc.height / 2.0 - ICON_PX / 2.0 + 2
        return (x - cx) ** 2 + (y - cy) ** 2 <= 14 ** 2

    def redraw(self):
        self.icon_area.queue_draw()

    # -- hover -------------------------------------------------------------- #

    def set_scale(self, target):
        if abs(target - self.target_scale) < 0.001:
            return
        self.anim_from = self.scale
        self.target_scale = target
        self.anim_start = GLib.get_monotonic_time()
        self.win.start_scale_anim()

    def on_enter(self, widget, event):
        if event.detail == Gdk.NotifyType.INFERIOR:
            return False
        if not self.win.jiggling:
            self.set_scale(HOVER_SCALE)
        return False

    def on_leave(self, widget, event):
        if event.detail == Gdk.NotifyType.INFERIOR:
            return False
        self.set_scale(1.0)
        return False

    # -- pointer ------------------------------------------------------------ #

    def on_press(self, widget, event):
        if event.type != Gdk.EventType.BUTTON_PRESS:
            return True
        if event.button == 3:
            self.popup_menu(event)
            return True
        if event.button != 1:
            return True

        if self.win.jiggling:
            if not self.is_folder() and self.badge_hit(event.x, event.y):
                self.win.remove_app(self)
                return True
            self.win.stop_jiggle()
            return True

        self._press_xy = (event.x_root, event.y_root)
        self._gesture = None
        self.win.pointer_press(event.x_root, event.y_root)
        self.set_scale(PRESS_SCALE)
        self._cancel_press_timer()
        self._press_timer = GLib.timeout_add(600, self._long_press)
        return True

    def _long_press(self):
        self._press_timer = None
        self.set_scale(1.0)
        if not self.is_folder():
            self.win.start_jiggle()
        return False

    def _cancel_press_timer(self):
        if self._press_timer is not None:
            GLib.source_remove(self._press_timer)
            self._press_timer = None

    def on_motion(self, widget, event):
        if self._press_xy is None or self._gesture is not None:
            return False
        dx = event.x_root - self._press_xy[0]
        dy = event.y_root - self._press_xy[1]
        if max(abs(dx), abs(dy)) < DRAG_THRESHOLD:
            return False
        self._cancel_press_timer()
        self.set_scale(1.0)
        # Dragging an icon picks it up (macOS behaviour): drop it on another
        # icon to make a folder, or on the dock to pin it. Page flipping is
        # done by dragging the empty background, scrolling, or the dots.
        self._gesture = "dnd"
        self.win.dragging = True
        self.drag_begin_with_coordinates(
            self.targets, Gdk.DragAction.COPY | Gdk.DragAction.MOVE,
            1, event, -1, -1)
        return False

    def on_release(self, widget, event):
        if event.button != 1:
            return True
        had_timer = self._press_timer is not None
        self._cancel_press_timer()
        gesture = self._gesture
        self._press_xy = None
        self._gesture = None
        if gesture == "dnd":
            return True
        self.set_scale(HOVER_SCALE)
        if had_timer and not self.win.jiggling and not self.win.dragging:
            self.activate_tile()
        return True

    def activate_tile(self):
        if self.is_folder():
            self.win.open_folder(self)
        else:
            self.win.launch(self.app)

    # -- drag source --------------------------------------------------------- #

    def on_drag_begin(self, widget, ctx):
        self.win.dragging = True
        self._cancel_press_timer()
        if self.is_folder():
            Gtk.drag_set_icon_name(ctx, "folder", ICON_PX // 2, ICON_PX // 2)
        else:
            Gtk.drag_set_icon_pixbuf(ctx, self.pixbuf(),
                                     ICON_PX // 2, ICON_PX // 2)

    def on_drag_data_get(self, widget, ctx, selection, info, time):
        target = selection.get_target().name()
        if target == DND_ITEM:
            selection.set(selection.get_target(), 8, self.key().encode())
            return
        if not self.path:
            return
        uri = Gio.File.new_for_path(self.path).get_uri()
        if target == "text/uri-list":
            selection.set_uris([uri])
        elif target in ("UTF8_STRING", "COMPOUND_TEXT", "TEXT", "STRING",
                        "text/plain", "text/plain;charset=utf-8"):
            selection.set_text(uri, -1)
        else:
            selection.set(selection.get_target(), 8, uri.encode())

    def on_drag_end(self, widget, ctx):
        self.win.dragging = False
        self._gesture = None
        self._press_xy = None
        self.set_scale(1.0)

    # -- drop target ---------------------------------------------------------- #

    def on_drag_motion(self, widget, ctx, x, y, time):
        source = Gtk.drag_get_source_widget(ctx)
        ok = source is not None and source is not self and not source.is_folder()
        if ok and not self.drop_hint:
            self.drop_hint = True
            self.redraw()
        Gdk.drag_status(ctx, Gdk.DragAction.MOVE if ok else 0, time)
        return True

    def on_drag_leave(self, widget, ctx, time):
        if self.drop_hint:
            self.drop_hint = False
            self.redraw()

    def on_drag_data_received(self, widget, ctx, x, y, selection, info, time):
        self.drop_hint = False
        self.redraw()
        try:
            key = selection.get_data().decode()
        except Exception:
            Gtk.drag_finish(ctx, False, False, time)
            return
        handled = self.win.handle_item_drop(key, self)
        Gtk.drag_finish(ctx, handled, False, time)

    # -- context menu ---------------------------------------------------------- #

    def popup_menu(self, event):
        menu = Gtk.Menu()
        self.win.menu_open = True

        if self.is_folder():
            item = Gtk.MenuItem(label="Open Folder")
            item.connect("activate", lambda *_: self.win.open_folder(self))
            menu.append(item)
            item = Gtk.MenuItem(label="Rename Folder…")
            item.connect("activate", lambda *_: self.win.rename_folder(self))
            menu.append(item)
            item = Gtk.MenuItem(label="Break Up Folder")
            item.connect("activate", lambda *_: self.win.dissolve_folder(self))
            menu.append(item)
        else:
            actions = []
            try:
                actions = list(self.app.list_actions() or [])
            except AttributeError:
                actions = []
            for action in actions:
                try:
                    name = self.app.get_action_name(action)
                except Exception:
                    name = action
                item = Gtk.MenuItem(label=name or action)
                item.connect("activate", self.on_action, action)
                menu.append(item)
            if actions:
                menu.append(Gtk.SeparatorMenuItem())
            for label, cb in (("Add to Plank Dock", self.on_pin),
                              ("Add to Desktop", self.on_desktop),
                              ("Show in Files", self.on_show_files),
                              ("Copy Command", self.on_copy_cmd)):
                item = Gtk.MenuItem(label=label)
                item.connect("activate", cb)
                item.set_sensitive(bool(self.path))
                menu.append(item)
            menu.append(Gtk.SeparatorMenuItem())
            item = Gtk.MenuItem(label="Remove…")
            item.connect("activate", lambda *_: self.win.remove_app(self))
            menu.append(item)

        menu.connect("deactivate", lambda *_: GLib.timeout_add(
            120, self._clear_menu_flag))
        menu.show_all()
        menu.popup_at_pointer(event)

    def _clear_menu_flag(self):
        self.win.menu_open = False
        return False

    def on_action(self, item, action):
        try:
            self.app.launch_action(action, self.win.launch_context())
        except Exception as exc:
            self.win.error("Could not run that action.", str(exc))
            return
        self.win.hide_launcher()

    def on_pin(self, *_):
        ok, err = plank_pin(self.path)
        if ok:
            self.win.toast("Added “%s” to the dock." % self.display_name())
        else:
            self.win.error("Could not add to the dock.", err)

    def on_desktop(self, *_):
        dest_dir = GLib.get_user_special_dir(
            GLib.UserDirectory.DIRECTORY_DESKTOP) or os.path.expanduser("~/Desktop")
        try:
            os.makedirs(dest_dir, exist_ok=True)
            dest = os.path.join(dest_dir, os.path.basename(self.path))
            Gio.File.new_for_path(self.path).copy(
                Gio.File.new_for_path(dest), Gio.FileCopyFlags.OVERWRITE,
                None, None, None)
            os.chmod(dest, 0o755)
            subprocess.call(["gio", "set", dest, "metadata::trusted", "true"],
                            stderr=subprocess.DEVNULL)
        except Exception as exc:
            self.win.error("Could not copy to the desktop.", str(exc))
            return
        self.win.toast("Added “%s” to the desktop." % self.display_name())

    def on_show_files(self, *_):
        run_bg(["nemo", "--no-desktop", "--select", self.path])
        self.win.hide_launcher()

    def on_copy_cmd(self, *_):
        cmd = self.app.get_commandline() or self.app.get_executable() or ""
        clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clip.set_text(cmd, -1)
        clip.store()
        self.win.toast("Copied: %s" % cmd)


# --------------------------------------------------------------------------- #
#  Page dots
# --------------------------------------------------------------------------- #

class PageDots(Gtk.EventBox):
    def __init__(self, window):
        super().__init__()
        self.win = window
        self.count = 1
        self.current = 0
        self.set_visible_window(False)
        # Same trap as the tiles: the DrawingArea owns a window, so without
        # this the clicks never reached the EventBox and the dots were dead.
        self.set_above_child(True)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                        | Gdk.EventMask.BUTTON_RELEASE_MASK)
        self.area = Canvas()
        self.area.set_size_request(-1, DOTS_AREA)
        self.area.connect("draw", self.on_draw)
        self.add(self.area)
        self.connect("button-press-event", self.on_click)

    def configure(self, count, current):
        self.count = max(1, count)
        self.current = current
        self.area.queue_draw()

    def _positions(self, width):
        gap = 20.0
        start = width / 2.0 - (self.count - 1) * gap / 2.0
        return [start + i * gap for i in range(self.count)]

    def on_draw(self, area, cr):
        if self.count <= 1:
            return False
        w = area.get_allocated_width()
        h = area.get_allocated_height()
        for i, x in enumerate(self._positions(w)):
            if i == self.current:
                cr.set_source_rgba(1, 1, 1, 0.95); r = 4.4
            else:
                cr.set_source_rgba(1, 1, 1, 0.34); r = 4.0
            cr.arc(x, h / 2.0, r, 0, 2 * math.pi)
            cr.fill()
        return False

    def on_click(self, widget, event):
        if self.count <= 1:
            return True
        w = self.area.get_allocated_width()
        best, best_dx = None, 1e9
        for i, x in enumerate(self._positions(w)):
            dx = abs(event.x - x)
            if dx < best_dx:
                best, best_dx = i, dx
        # generous hit area - the dots themselves are only ~9px across
        if best is not None and best_dx <= 14:
            self.win.goto_page(best)
        return True


# --------------------------------------------------------------------------- #
#  Main window
# --------------------------------------------------------------------------- #

class LaunchpadWindow(Gtk.Window):
    def __init__(self, app):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.gtk_app = app
        self.backdrop = None
        self.anim_scale = 1.0
        self._anim_tick = None
        self._scale_tick = None
        self.jiggling = False
        self._jiggle_timer = None
        self._jiggle_phase = 0
        self._hidden_at = 0.0
        self.dragging = False
        self.menu_open = False
        self.tiles = []
        self.pages = []
        self.page = 0
        self._bg_press = None
        self._toast_timer = None
        self._scroll_accum = 0.0
        self._last_page_change = 0
        self.open_folder_tile = None

        self.apps_by_id = {}
        self.app_tiles = {}
        self.folder_tiles = {}
        self.layout = None

        self.set_app_paintable(True)
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.NORMAL)
        self.set_title("Launchpad")
        self.stick()

        visual = self.get_screen().get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)

        # Scroll is handled at the toplevel so it works no matter which child
        # the pointer happens to be over.
        self.add_events(Gdk.EventMask.SCROLL_MASK
                        | Gdk.EventMask.SMOOTH_SCROLL_MASK)
        self.connect("scroll-event", self.on_scroll)
        self.connect("draw", self.on_draw)
        self.connect("key-press-event", self.on_key)
        self.connect("delete-event", self.on_delete)
        self.connect("focus-out-event", self.on_focus_out)

        self.build_ui()
        self.reload_apps()

        self.monitor = Gio.AppInfoMonitor.get()
        self.monitor.connect("changed", lambda *_: self.reload_apps())

    # -- construction -------------------------------------------------------- #

    def build_ui(self):
        self.bg_events = Gtk.EventBox()
        self.bg_events.set_visible_window(False)
        self.bg_events.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                                  | Gdk.EventMask.BUTTON_RELEASE_MASK
                                  | Gdk.EventMask.POINTER_MOTION_MASK
                                  | Gdk.EventMask.SCROLL_MASK
                                  | Gdk.EventMask.SMOOTH_SCROLL_MASK)
        self.bg_events.connect("button-press-event", self.on_bg_press)
        self.bg_events.connect("button-release-event", self.on_bg_release)
        self.bg_events.connect("scroll-event", self.on_scroll)
        self.add(self.bg_events)

        self.overlay = Gtk.Overlay()
        self.bg_events.add(self.overlay)

        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.overlay.add(self.content)

        search_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        search_row.set_size_request(-1, TOP_AREA)
        self.entry = Gtk.SearchEntry()
        self.entry.set_placeholder_text("Search")
        self.entry.set_width_chars(24)
        self.entry.set_max_width_chars(24)
        self.entry.set_halign(Gtk.Align.CENTER)
        self.entry.set_valign(Gtk.Align.CENTER)
        self.entry.get_style_context().add_class("lp-search")
        self.entry.connect("search-changed", lambda *_: self.apply_filter())
        self.entry.connect("activate", self.on_entry_activate)
        search_row.set_center_widget(self.entry)
        self.content.pack_start(search_row, False, False, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(210)
        self.stack.set_homogeneous(True)
        self.content.pack_start(self.stack, True, True, 0)

        self.dots = PageDots(self)
        self.content.pack_start(self.dots, False, False, 0)

        self.toast_label = Gtk.Label()
        self.toast_label.get_style_context().add_class("lp-toast")
        self.toast_label.set_no_show_all(True)
        self.content.pack_start(self.toast_label, False, False, 0)

        self.dock_spacer = Gtk.Box()
        self.content.pack_start(self.dock_spacer, False, False, 0)

        self.build_folder_panel()

    def build_folder_panel(self):
        # A full-size click catcher sitting above the (dimmed) grid. It is
        # needed because dimming the background with set_sensitive(False) makes
        # GTK treat clicks on it as already handled - gtk_propagate_event does
        #     handled = !gtk_widget_is_sensitive (widget) || gtk_widget_event (...)
        # and stops - so clicks never reached the background handler and the
        # folder could not be dismissed by clicking outside it.
        self.folder_shade = Gtk.EventBox()
        self.folder_shade.set_visible_window(False)
        self.folder_shade.set_above_child(False)   # panel's own children win
        self.folder_shade.set_no_show_all(True)
        self.folder_shade.set_halign(Gtk.Align.FILL)
        self.folder_shade.set_valign(Gtk.Align.FILL)
        self.folder_shade.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                                     | Gdk.EventMask.BUTTON_RELEASE_MASK)
        self.folder_shade.connect("button-release-event", self.on_shade_click)
        self.folder_shade.connect("draw", self.on_shade_draw)

        self.folder_panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL,
                                    spacing=14)
        self.folder_panel.get_style_context().add_class("lp-folder")
        self.folder_panel.set_halign(Gtk.Align.CENTER)
        self.folder_panel.set_valign(Gtk.Align.CENTER)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.folder_name = Gtk.Entry()
        self.folder_name.set_halign(Gtk.Align.CENTER)
        self.folder_name.set_alignment(0.5)
        self.folder_name.set_width_chars(18)
        self.folder_name.set_has_frame(False)
        self.folder_name.get_style_context().add_class("lp-folder-name")
        self.folder_name.connect("activate", self.on_folder_rename)
        self.folder_name.connect("focus-out-event", self.on_folder_rename)
        self.folder_name.set_hexpand(True)
        header.pack_start(self.folder_name, True, True, 0)

        close = Gtk.Button(label="\u2715")
        close.set_relief(Gtk.ReliefStyle.NONE)
        close.set_valign(Gtk.Align.CENTER)
        close.get_style_context().add_class("lp-folder-close")
        close.set_tooltip_text("Close folder  (Esc)")
        close.connect("clicked", lambda *_: self.close_folder())
        header.pack_end(close, False, False, 0)
        self.folder_close_btn = close

        self.folder_panel.pack_start(header, False, False, 0)

        self.folder_grid = Gtk.Grid()
        self.folder_grid.set_column_spacing(COL_SPACING)
        self.folder_grid.set_row_spacing(ROW_SPACING)
        self.folder_grid.set_halign(Gtk.Align.CENTER)

        self.folder_scroll = Gtk.ScrolledWindow()
        self.folder_scroll.set_policy(Gtk.PolicyType.NEVER,
                                      Gtk.PolicyType.AUTOMATIC)
        self.folder_scroll.set_propagate_natural_width(True)
        self.folder_scroll.set_propagate_natural_height(True)
        self.folder_scroll.add(self.folder_grid)
        self.folder_panel.pack_start(self.folder_scroll, True, True, 0)

        self.folder_shade.add(self.folder_panel)
        self.overlay.add_overlay(self.folder_shade)

    # -- model --------------------------------------------------------------- #

    def reload_apps(self):
        apps = all_apps()
        self.apps_by_id = {a.get_id(): a for a in apps}
        self.layout = Layout.load(apps)
        self.rebuild_tiles()
        return False

    def rebuild_tiles(self):
        """Recreate top-level tiles from the layout, reusing app tiles."""
        for tile in list(self.app_tiles.values()) + list(self.folder_tiles.values()):
            parent = tile.get_parent()
            if parent is not None:
                parent.remove(tile)

        wanted_folders = set()
        tiles = []
        for entry in self.layout.items:
            if entry["type"] == "folder":
                fid = entry["id"]
                wanted_folders.add(fid)
                tile = self.folder_tiles.get(fid)
                if tile is None:
                    tile = Tile(self, folder=entry)
                    self.folder_tiles[fid] = tile
                else:
                    tile.folder = entry
                    tile.refresh_label()
                    tile.redraw()
                tiles.append(tile)
            else:
                app = self.apps_by_id.get(entry["id"])
                if app is None:
                    continue
                tiles.append(self.app_tile(app))
        for fid in list(self.folder_tiles):
            if fid not in wanted_folders:
                tile = self.folder_tiles.pop(fid)
                tile.destroy()
        self.tiles = tiles
        self.rebuild_pages(tiles)

    def app_tile(self, app):
        tile = self.app_tiles.get(app.get_id())
        if tile is None:
            tile = Tile(self, app=app)
            self.app_tiles[app.get_id()] = tile
        return tile

    def all_tiles(self):
        return list(self.app_tiles.values()) + list(self.folder_tiles.values())

    # -- grid ----------------------------------------------------------------- #

    def grid_shape(self):
        geo = self.current_geometry()
        usable_w = geo.width - 2 * SIDE_MARGIN
        cols = max(4, min(9, int((usable_w + COL_SPACING) // (TILE_W + COL_SPACING))))
        reserved = TOP_AREA + DOTS_AREA + self.dock_gap() + 16
        usable_h = geo.height - reserved
        rows = max(3, int((usable_h + ROW_SPACING) // (TILE_H + ROW_SPACING)))
        return cols, rows

    def rebuild_pages(self, tiles):
        # Detach everything first: removing a grid drops the last reference to
        # it, which would destroy the tiles still parented to it.
        for tile in self.all_tiles():
            parent = tile.get_parent()
            if parent is not None:
                parent.remove(tile)
        for child in self.stack.get_children():
            self.stack.remove(child)
        self.pages = []

        cols, rows = self.grid_shape()
        per_page = max(1, cols * rows)

        if not tiles:
            empty = Gtk.Label(label="No applications found")
            empty.get_style_context().add_class("app-label")
            self.stack.add_named(empty, "page0")
            self.pages = [empty]
            self.page = 0
            self.dots.configure(1, 0)
            self.stack.show_all()
            return

        for index in range(0, len(tiles), per_page):
            grid = Gtk.Grid()
            grid.set_column_spacing(COL_SPACING)
            grid.set_row_spacing(ROW_SPACING)
            grid.set_halign(Gtk.Align.CENTER)
            grid.set_valign(Gtk.Align.CENTER)
            for position, tile in enumerate(tiles[index:index + per_page]):
                grid.attach(tile, position % cols, position // cols, 1, 1)
            self.stack.add_named(grid, "page%d" % len(self.pages))
            self.pages.append(grid)

        self.page = min(self.page, len(self.pages) - 1)
        self.stack.set_visible_child_name("page%d" % self.page)
        self.dots.configure(len(self.pages), self.page)
        self.stack.show_all()

    def apply_filter(self):
        query = self.entry.get_text().strip().lower()
        if not query:
            self.filtered = self.tiles
            visible = self.tiles
        else:
            terms = query.split()
            # search reaches inside folders, like macOS
            visible = [self.app_tile(a) for a in
                       sorted(self.apps_by_id.values(),
                              key=lambda a: (a.get_display_name() or "").lower())
                       if all(t in search_haystack(a) for t in terms)]
            self.filtered = visible
        self.close_folder()
        self.page = 0
        transition = self.stack.get_transition_type()
        self.stack.set_transition_type(Gtk.StackTransitionType.NONE)
        self.rebuild_pages(visible)
        self.stack.set_transition_type(transition)

    def on_entry_activate(self, *_):
        tiles = getattr(self, "filtered", None) or self.tiles
        if tiles:
            tiles[0].activate_tile()

    # -- folders ---------------------------------------------------------------- #

    def open_folder(self, tile):
        if not tile.is_folder():
            return
        self.open_folder_tile = tile
        for child in self.folder_grid.get_children():
            self.folder_grid.remove(child)
        cols = min(FOLDER_COLS, max(1, len(tile.folder["apps"])))
        for i, aid in enumerate(tile.folder["apps"]):
            app = self.apps_by_id.get(aid)
            if app is None:
                continue
            child = self.app_tile(app)
            parent = child.get_parent()
            if parent is not None:
                parent.remove(child)
            self.folder_grid.attach(child, i % cols, i // cols, 1, 1)
        # Size the viewport to a whole number of rows, so a partly visible
        # row never gets its labels sliced off at the panel edge.
        geo = self.current_geometry()
        avail = geo.height - self.dock_gap() - FOLDER_CHROME
        row_h = TILE_H + ROW_SPACING
        rows = max(1, int(avail // row_h))
        needed = -(-len(tile.folder["apps"]) // cols)
        rows = min(rows, needed)
        self.folder_scroll.set_max_content_height(
            rows * TILE_H + (rows - 1) * ROW_SPACING)

        self.folder_name.set_text(tile.folder["name"])
        # show_all() is a no-op on a widget with no_show_all set, so the
        # children have to be shown explicitly.
        self.folder_panel.show_all()
        self.folder_shade.show()
        self.content.set_sensitive(False)

    def close_folder(self):
        if self.open_folder_tile is None:
            return
        for child in self.folder_grid.get_children():
            self.folder_grid.remove(child)
        self.folder_shade.hide()
        self.folder_panel.hide()
        self.content.set_sensitive(True)
        self.open_folder_tile = None
        # tiles pulled into the folder view have to go back on their page
        self.rebuild_pages(self.tiles)

    def on_shade_draw(self, widget, cr):
        """Dim everything behind an open folder, the way macOS does."""
        alloc = widget.get_allocation()
        cr.set_source_rgba(0, 0, 0, 0.55)
        cr.rectangle(0, 0, alloc.width, alloc.height)
        cr.fill()
        return False   # let the panel draw on top

    def on_shade_click(self, widget, event):
        """A click anywhere outside the panel dismisses the folder."""
        if event.button != 1 or self.open_folder_tile is None:
            return False
        alloc = self.folder_panel.get_allocation()
        inside = (alloc.x <= event.x <= alloc.x + alloc.width
                  and alloc.y <= event.y <= alloc.y + alloc.height)
        if not inside:
            self.close_folder()
            return True
        return False

    def on_folder_rename(self, *_):
        if self.open_folder_tile is None:
            return False
        name = self.folder_name.get_text().strip()
        if name and name != self.open_folder_tile.folder["name"]:
            self.open_folder_tile.folder["name"] = name
            self.open_folder_tile.refresh_label()
            self.layout.save()
        return False

    def rename_folder(self, tile):
        self.open_folder(tile)
        self.folder_name.grab_focus()
        self.folder_name.select_region(0, -1)

    def dissolve_folder(self, tile):
        entry = self.layout.find_folder(tile.folder["id"])
        if entry is None:
            return
        index = self.layout.items.index(entry)
        self.layout.items[index:index + 1] = [{"type": "app", "id": a}
                                              for a in entry["apps"]]
        self.layout.save()
        self.close_folder()
        self.rebuild_tiles()
        self.toast("Broke up “%s”." % entry["name"])

    def handle_item_drop(self, key, target):
        """A tile was dropped on another tile: make or grow a folder."""
        if key.startswith("folder:") or target.key() == key:
            return False
        if key not in self.apps_by_id:
            return False
        if target.is_folder():
            folder = self.layout.add_to_folder(key, target.folder["id"])
            if folder is None:
                return False
            name = folder["name"]
        else:
            target_id = target.app.get_id()
            if target_id == key:
                return False
            suggested = categorise(target.app)
            folder = self.layout.make_folder(key, target_id, suggested)
            if folder is None:
                return False
            name = folder["name"]
        self.layout.save()
        self.rebuild_tiles()
        self.toast("Added “%s” to “%s”."
                   % (self.apps_by_id[key].get_display_name(), name))
        return True

    # -- paging ------------------------------------------------------------------ #

    def goto_page(self, index, animate=True):
        if not self.pages:
            return
        index = max(0, min(index, len(self.pages) - 1))
        if index == self.page:
            return
        self.stack.set_transition_type(
            Gtk.StackTransitionType.SLIDE_LEFT_RIGHT if animate
            else Gtk.StackTransitionType.NONE)
        self.page = index
        self.stack.set_visible_child_name("page%d" % index)
        self.dots.configure(len(self.pages), index)
        self._last_page_change = GLib.get_monotonic_time()

    def on_scroll(self, widget, event):
        if self.open_folder_tile is not None:
            return False   # let the folder's ScrolledWindow have it
        if event.direction == Gdk.ScrollDirection.SMOOTH:
            # Touchpads emit a stream of small deltas, so accumulate them and
            # debounce, or one flick would race through every page.
            ok, dx, dy = event.get_scroll_deltas()
            if not ok:
                return True
            if GLib.get_monotonic_time() - self._last_page_change < PAGE_COOLDOWN_US:
                self._scroll_accum = 0.0   # don't bank scroll during the settle
                return True
            self._scroll_accum += dx if abs(dx) > abs(dy) else dy
            if abs(self._scroll_accum) < 0.9:
                return True
            step = 1 if self._scroll_accum > 0 else -1
            self._scroll_accum = 0.0
            self.goto_page(self.page + step)
            return True

        # A mouse wheel detent is already discrete: one click, one page.
        # Debouncing these would swallow legitimate fast scrolling.
        if event.direction in (Gdk.ScrollDirection.DOWN,
                               Gdk.ScrollDirection.RIGHT):
            self.goto_page(self.page + 1)
        elif event.direction in (Gdk.ScrollDirection.UP,
                                 Gdk.ScrollDirection.LEFT):
            self.goto_page(self.page - 1)
        return True

    # -- background gestures -------------------------------------------------------- #

    def pointer_press(self, x_root, y_root):
        self._bg_press = (x_root, y_root)

    def pointer_release(self, x_root, y_root):
        if self._bg_press is None:
            return "none"
        dx = x_root - self._bg_press[0]
        dy = y_root - self._bg_press[1]
        self._bg_press = None
        if abs(dx) > SWIPE_MIN and abs(dx) > abs(dy):
            self.goto_page(self.page + (1 if dx < 0 else -1))
            return "swipe"
        if abs(dx) < 10 and abs(dy) < 10:
            return "click"
        return "none"

    def on_bg_press(self, widget, event):
        if event.button == 1:
            self.pointer_press(event.x_root, event.y_root)
        return True

    def on_bg_release(self, widget, event):
        if event.button != 1:
            return True
        if self.pointer_release(event.x_root, event.y_root) == "click":
            if self.open_folder_tile is not None:
                self.close_folder()
            elif self.jiggling:
                self.stop_jiggle()
            else:
                self.hide_launcher()
        return True

    # -- keyboard ---------------------------------------------------------------------- #

    def on_key(self, widget, event):
        key = event.keyval
        has_text = bool(self.entry.get_text())

        if key == Gdk.KEY_Escape:
            if self.open_folder_tile is not None:
                self.close_folder()
            elif self.jiggling:
                self.stop_jiggle()
            elif has_text:
                self.entry.set_text("")
            else:
                self.hide_launcher()
            return True

        if self.open_folder_tile is not None:
            return False

        if key == Gdk.KEY_Page_Down:
            self.goto_page(self.page + 1); return True
        if key == Gdk.KEY_Page_Up:
            self.goto_page(self.page - 1); return True
        if key == Gdk.KEY_Home and not has_text:
            self.goto_page(0); return True
        if key == Gdk.KEY_End and not has_text:
            self.goto_page(len(self.pages) - 1); return True
        if key in (Gdk.KEY_Right, Gdk.KEY_Left) and not has_text:
            self.goto_page(self.page + (1 if key == Gdk.KEY_Right else -1))
            return True

        if not self.entry.has_focus():
            self.entry.grab_focus()
            self.entry.set_position(-1)
        return False

    def on_focus_out(self, *_):
        if self.dragging or self.menu_open or self.jiggling:
            return False
        GLib.timeout_add(120, self._maybe_hide_on_focus)
        return False

    def _maybe_hide_on_focus(self):
        if not (self.dragging or self.menu_open or self.jiggling
                or self.has_toplevel_focus()):
            self.hide_launcher()
        return False

    def on_delete(self, *_):
        self.hide_launcher()
        return True

    # -- jiggle ------------------------------------------------------------------------- #

    def start_jiggle(self):
        if self.jiggling:
            return
        self.jiggling = True
        self._jiggle_phase = 0
        self._jiggle_timer = GLib.timeout_add(90, self._jiggle_step)

    def _jiggle_step(self):
        self._jiggle_phase += 1
        base = math.radians(JIGGLE_DEG)
        for i, tile in enumerate(self.tiles):
            tile.angle = base * math.sin((self._jiggle_phase + i * 2) * 0.9)
            tile.redraw()
        return True

    def stop_jiggle(self):
        if not self.jiggling:
            return
        self.jiggling = False
        if self._jiggle_timer is not None:
            GLib.source_remove(self._jiggle_timer)
            self._jiggle_timer = None
        for tile in self.all_tiles():
            tile.angle = 0.0
            tile.redraw()

    # -- removal -------------------------------------------------------------------------- #

    def remove_app(self, tile):
        if tile.is_folder():
            return
        app, path = tile.app, tile.path
        name = app.get_display_name() or "this app"
        home = os.path.expanduser("~")

        if path and path.startswith(home) and os.access(path, os.W_OK):
            if not self.confirm("Remove “%s”?" % name,
                                "Its launcher will be moved to the Bin. You can "
                                "restore it from there."):
                return
            try:
                Gio.File.new_for_path(path).trash(None)
            except GLib.Error as exc:
                self.error("Could not remove “%s”." % name, exc.message)
                return
            self.stop_jiggle()
            self.layout.remove_app(app.get_id())
            self.layout.save()
            self.toast("Moved “%s” to the Bin." % name)
            GLib.timeout_add(150, self.reload_apps)
            return

        pkg, manager = self.owning_package(path)
        if pkg is None:
            self.error("“%s” can't be removed automatically." % name,
                       "Its launcher lives in %s, which belongs to the system, "
                       "and no package manager claims it."
                       % (os.path.dirname(path) if path else "an unknown location"))
            return
        if not self.confirm("Uninstall “%s”?" % name,
                            "This removes the %s package “%s”. A terminal will "
                            "open so you can review exactly what gets removed "
                            "before confirming." % (manager, pkg)):
            return
        self.stop_jiggle()
        self.hide_launcher()
        self.run_uninstall(pkg, manager)

    def owning_package(self, path):
        if not path:
            return None, None
        if "/flatpak/" in path:
            base = os.path.basename(path)
            return (base[:-len(".desktop")] if base.endswith(".desktop") else base,
                    "Flatpak")
        if path.startswith("/var/lib/snapd") or "/snap/" in path:
            parts = path.split("/")
            if "snap" in parts:
                idx = parts.index("snap")
                if idx + 1 < len(parts):
                    return parts[idx + 1], "Snap"
        try:
            out = subprocess.check_output(["dpkg", "-S", path], text=True,
                                          stderr=subprocess.DEVNULL)
            return out.split(":")[0].strip(), "APT"
        except Exception:
            return None, None

    def run_uninstall(self, pkg, manager):
        if manager == "Flatpak":
            inner = "flatpak uninstall %s" % shlex.quote(pkg)
        elif manager == "Snap":
            inner = "sudo snap remove %s" % shlex.quote(pkg)
        else:
            inner = "sudo apt remove %s" % shlex.quote(pkg)
        script = ("%s; echo; read -n 1 -s -r -p 'Done - press any key to close'"
                  % inner)
        for term in (["gnome-terminal", "--", "bash", "-c", script],
                     ["x-terminal-emulator", "-e", "bash", "-c", script],
                     ["xterm", "-e", "bash", "-c", script]):
            if run_bg(term):
                return
        self.error("Could not open a terminal.",
                   "Run this yourself:\n\n    %s" % inner)

    # -- dialogs / toast ------------------------------------------------------------------- #

    def confirm(self, primary, secondary):
        self.menu_open = True
        dialog = Gtk.MessageDialog(transient_for=self, modal=True,
                                   message_type=Gtk.MessageType.QUESTION,
                                   buttons=Gtk.ButtonsType.OK_CANCEL,
                                   text=primary)
        dialog.format_secondary_text(secondary)
        response = dialog.run()
        dialog.destroy()
        self.menu_open = False
        return response == Gtk.ResponseType.OK

    def error(self, primary, secondary):
        self.menu_open = True
        dialog = Gtk.MessageDialog(transient_for=self, modal=True,
                                   message_type=Gtk.MessageType.WARNING,
                                   buttons=Gtk.ButtonsType.CLOSE, text=primary)
        if secondary:
            dialog.format_secondary_text(secondary)
        dialog.run()
        dialog.destroy()
        self.menu_open = False

    def toast(self, text):
        self.toast_label.set_text(text)
        self.toast_label.show()
        if self._toast_timer is not None:
            GLib.source_remove(self._toast_timer)
        self._toast_timer = GLib.timeout_add(2200, self._hide_toast)

    def _hide_toast(self):
        self.toast_label.hide()
        self._toast_timer = None
        return False

    # -- launching ---------------------------------------------------------------------------- #

    def launch_context(self):
        ctx = self.get_display().get_app_launch_context()
        ctx.set_timestamp(Gtk.get_current_event_time())
        return ctx

    def launch(self, app):
        try:
            app.launch(None, self.launch_context())
        except GLib.Error as exc:
            self.error("Could not launch “%s”."
                       % (app.get_display_name() or "app"), exc.message)
            return
        self.hide_launcher()

    # -- geometry / show / hide ------------------------------------------------------------------ #

    def current_geometry(self):
        display = Gdk.Display.get_default()
        monitor = None
        try:
            pointer = display.get_default_seat().get_pointer()
            _, x, y = pointer.get_position()[:3]
            monitor = display.get_monitor_at_point(x, y)
        except Exception:
            monitor = None
        if monitor is None:
            monitor = display.get_primary_monitor() or display.get_monitor(0)
        return monitor.get_workarea()

    def dock_gap(self):
        return plank_height()

    def on_draw(self, widget, cr):
        width = self.get_allocated_width()
        height = self.get_allocated_height()
        cr.set_operator(1)
        if self.backdrop is not None:
            Gdk.cairo_set_source_pixbuf(cr, self.backdrop, 0, 0)
            cr.paint()
            cr.set_operator(2)
            cr.set_source_rgba(0.04, 0.04, 0.06, 0.62)
            cr.rectangle(0, 0, width, height)
            cr.fill()
        else:
            cr.set_source_rgba(0.05, 0.05, 0.07, 0.90)
            cr.paint()
        return False

    def folder_is_open(self):
        return self.open_folder_tile is not None

    def show_launcher(self):
        if self.get_visible():
            self.hide_launcher()
            return
        if GLib.get_monotonic_time() / 1e6 - self._hidden_at < 0.45:
            return

        geo = self.current_geometry()
        gap = self.dock_gap()
        if RESERVE_DOCK:
            width, height = geo.width, geo.height - gap
            self.dock_spacer.set_size_request(-1, 0)
        else:
            width, height = geo.width, geo.height
            self.dock_spacer.set_size_request(-1, gap)

        self.backdrop = capture_backdrop(width, height)
        self.set_size_request(width, height)
        self.resize(width, height)

        self.entry.set_text("")
        self.close_folder()
        self.stop_jiggle()
        self.rebuild_pages(self.tiles)
        self.filtered = self.tiles
        self.goto_page(0, animate=False)

        self.anim_scale = 0.86
        self.content.set_opacity(0.0)
        self.move(geo.x, geo.y)
        self.show_all()
        self.folder_shade.hide()
        self.folder_panel.hide()
        self.toast_label.hide()
        self.move(geo.x, geo.y)
        self.present_with_time(Gtk.get_current_event_time())
        self.entry.grab_focus()
        self.start_open_anim()

    def hide_launcher(self):
        self._hidden_at = GLib.get_monotonic_time() / 1e6
        self.stop_jiggle()
        self.close_folder()
        self._bg_press = None
        self.dragging = False
        self.menu_open = False
        self.hide()

    # -- animation ---------------------------------------------------------------------------------- #

    def start_open_anim(self):
        start = GLib.get_monotonic_time()

        def tick(widget, clock):
            elapsed = (GLib.get_monotonic_time() - start) / 1000.0
            t = min(1.0, elapsed / OPEN_MS)
            eased = ease_out(t)
            self.anim_scale = 0.86 + 0.14 * eased
            self.content.set_opacity(eased)
            for tile in self.tiles:
                tile.redraw()
            if t >= 1.0:
                self.anim_scale = 1.0
                for tile in self.all_tiles():
                    tile.scale = 1.0
                    tile.target_scale = 1.0
                self._anim_tick = None
                return GLib.SOURCE_REMOVE
            return GLib.SOURCE_CONTINUE

        if self._anim_tick is not None:
            self.remove_tick_callback(self._anim_tick)
        self._anim_tick = self.add_tick_callback(tick)

    def start_scale_anim(self):
        if self._scale_tick is not None:
            return

        def tick(widget, clock):
            now = GLib.get_monotonic_time()
            busy = False
            for tile in self.all_tiles():
                if tile.scale == tile.target_scale:
                    continue
                t = (now - tile.anim_start) / 1000.0 / HOVER_MS
                if t >= 1.0:
                    tile.scale = tile.target_scale
                else:
                    span = tile.target_scale - tile.anim_from
                    tile.scale = tile.anim_from + span * ease_out(t)
                    busy = True
                tile.redraw()
            if not busy:
                self._scale_tick = None
                return GLib.SOURCE_REMOVE
            return GLib.SOURCE_CONTINUE

        self._scale_tick = self.add_tick_callback(tick)


# --------------------------------------------------------------------------- #
#  Application
# --------------------------------------------------------------------------- #

CSS = b"""
.lp-search {
    background-color: rgba(255,255,255,0.14);
    color: #ffffff;
    border: 1px solid rgba(255,255,255,0.20);
    border-radius: 9px;
    padding: 5px 10px;
    caret-color: #ffffff;
}
.lp-search:focus {
    background-color: rgba(255,255,255,0.20);
    border-color: rgba(255,255,255,0.38);
}
.lp-search image { color: rgba(255,255,255,0.75); }
.lp-search selection { background-color: rgba(255,255,255,0.30); }

.app-label {
    color: #ffffff;
    font-size: 11.5px;
    text-shadow: 0 1px 3px rgba(0,0,0,0.85);
}

.lp-folder {
    background-color: rgba(32,32,36,0.985);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 22px;
    padding: 26px 34px 30px 34px;
}
.lp-folder-close {
    color: rgba(255,255,255,0.72);
    font-size: 15px;
    padding: 2px 9px;
    border-radius: 8px;
    border: none;
    background: transparent;
}
.lp-folder-close:hover {
    background-color: rgba(255,255,255,0.16);
    color: #ffffff;
}

.lp-folder-name {
    background: transparent;
    color: #ffffff;
    font-size: 16px;
    border: none;
    box-shadow: none;
    caret-color: #ffffff;
}

.lp-toast {
    color: #ffffff;
    background-color: rgba(0,0,0,0.55);
    border-radius: 9px;
    padding: 7px 14px;
    margin-bottom: 12px;
    font-size: 12px;
}

menu { background-color: #2b2b2e; }
menu menuitem { color: #f2f2f2; padding: 5px 12px; }
menu menuitem:hover { background-color: #3a7bd5; }
"""


class LaunchpadApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.window = None
        self.add_main_option("daemon", 0, GLib.OptionFlags.NONE,
                             GLib.OptionArg.NONE,
                             "Stay resident and start hidden", None)

    def do_startup(self):
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.hold()

    def ensure_window(self):
        if self.window is None:
            self.window = LaunchpadWindow(self)
            self.add_window(self.window)
        return self.window

    def do_command_line(self, command_line):
        options = command_line.get_options_dict().end().unpack()
        window = self.ensure_window()
        if options.get("daemon") and not command_line.get_is_remote():
            return 0
        window.show_launcher()
        return 0

    def do_activate(self):
        self.ensure_window().show_launcher()


def main():
    GLib.set_prgname("launchpad")
    Gdk.set_program_class("Launchpad")
    if not Gdk.Display.get_default() and "DISPLAY" not in os.environ:
        print("launchpad: no display available", file=sys.stderr)
        return 1
    return LaunchpadApp().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
