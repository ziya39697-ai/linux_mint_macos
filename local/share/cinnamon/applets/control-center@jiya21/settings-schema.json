{
    "head-general": {
        "type": "header",
        "description": "General"
    },
    "keyOpen": {
        "type": "keybinding",
        "default": "<Super>c",
        "description": "Show the Control Center"
    },
    "labelinfo": {
        "type": "combobox",
        "default": "percentage",
        "description": "Battery label in the panel",
        "options": {
            "Percentage": "percentage",
            "Time remaining": "time",
            "Percentage and time": "percentage_time",
            "Hide": "nothing"
        }
    },
    "head-wifi": {
        "type": "header",
        "description": "Wi-Fi"
    },
    "wifiListMode": {
        "type": "combobox",
        "default": "full",
        "description": "Networks to show",
        "options": {
            "All networks": "full",
            "Top 5, rest under \"More\"": "stock"
        }
    },
    "wifiMaxHeight": {
        "type": "spinbutton",
        "default": 320,
        "min": 120,
        "max": 800,
        "step": 20,
        "units": "pixels",
        "description": "Maximum Wi-Fi list height"
    },
    "head-bt": {
        "type": "header",
        "description": "Bluetooth"
    },
    "btSettingsCmd": {
        "type": "entry",
        "default": "",
        "description": "Bluetooth settings command (blank = auto-detect)"
    },
    "head-media": {
        "type": "header",
        "description": "Media"
    },
    "showMediaPlayer": {
        "type": "switch",
        "default": true,
        "description": "Show the Now Playing section"
    }
}
